{
    "title": "Hertz Demo Dashboard",
    "uid": "hertz-demo",
    "editable": true,
    "panels": [
        {
            "title": "Request Rate",
            "type": "timeseries",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(http_requests_total[5m])",
                    "legendFormat": "{{method}} {{path}} {{status}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                    }
                }
            ]
        },
        {
            "title": "Request Duration",
            "type": "timeseries",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "95th percentile",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                    }
                },
                {
                    "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "99th percentile",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                    }
                }
            ]
        },
        {
            "title": "Error Rate",
            "type": "timeseries",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
                    "legendFormat": "{{method}} {{path}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                    }
                }
            ]
        },
        {
            "title": "Active Requests",
            "type": "stat",
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "http_requests_in_progress",
                    "legendFormat": "Active",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                    }
                }
            ]
        },
        {
            "title": "Application Logs",
            "type": "logs",
            "gridPos": {
                "x": 0,
                "y": 16,
                "w": 24,
                "h": 8
            },
            "targets": [
                {
                    "expr": "{job=\"hertz_demo\"}",
                    "datasource": {
                        "type": "loki",
                        "uid": "P8E80F9AEF21F6940"
                    }
                }
            ]
        }
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "refresh": "5s"
}
