{
    "title": "Gateway Logs",
    "uid": "gateway-logs",
    "editable": true,
    "panels": [
        {
            "title": "Request Rate",
            "type": "timeseries",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(http_requests_total[5m])",
                    "legendFormat": "{{method}} {{path}} {{status}}",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                    }
                }
            ]
        },
        {
            "title": "Request Duration",
            "type": "timeseries",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "95th percentile",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                    }
                },
                {
                    "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "99th percentile",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                    }
                }
            ]
        },
        {
            "title": "Request Details",
            "type": "logs",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 24,
                "h": 24
            },
            "targets": [
                {
                    "expr": "{container=\"envoy_gateway\"} | json | method != \"\" | line_format \"[{{.timestamp}}] {{.method}} {{.path}} {{.status_code}} {{.duration_ms}}ms upstream={{.upstream_host}} request_id={{.request_id}}\"",
                    "datasource": {
                        "type": "loki",
                        "uid": "P8E80F9AEF21F6940"
                    }
                }
            ],
            "options": {
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "dedupStrategy": "none"
            }
        }
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "refresh": "5s"
}

